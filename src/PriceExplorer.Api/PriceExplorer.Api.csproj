<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>PriceExplorer.Api</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- XML docs feed OpenAPI descriptions. Only non-obvious members/parameters are documented (CS1591, CS1573). -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PriceExplorer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 12.5.0 is the last Apache-2.0 MediatR; 13+ needs a commercial/community license key. Same API as Kolbera's 12.4.1. -->
    <PackageReference Include="MediatR" Version="12.5.0" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.13" />
    <PackageReference Include="DuckDB.NET.Data.Full" Version="1.5.6" />
    <PackageReference Include="Dapper" Version="2.1.89" />
  </ItemGroup>

  <ItemGroup>
    <!-- Queries live in .sql files next to the handlers that run them. -->
    <EmbeddedResource Include="Core\**\*.sql" />
    <!-- Plain-language labels for official code sets (place of service, revenue code categories, modifiers). -->
    <EmbeddedResource Include="Core\Reference\*.tsv" />
  </ItemGroup>

  <ItemGroup>
    <!-- Prebuilt reference files (the provider directory and its source note) ship next to the app; see reference/README.md. -->
    <Content Include="..\..\reference\*.csv.gz;..\..\reference\*.source.json" Link="reference\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
